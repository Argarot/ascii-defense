{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-inline-scripts.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for inline scripts"
          }
        ]
      }
    ]
  }
}
