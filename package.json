{
  "name": "ascii-defense",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Roguelite tower defense rendered entirely in ASCII",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite packages/app",
    "typecheck": "tsc --build",
    "build": "npm run typecheck && vite build packages/app",
    "preview": "vite preview packages/app",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.11.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.5"
  }
}
